# ---- Add these lines to your .env ----
APP_NAME="Chandrabindu"
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multibranch_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
FILESYSTEM_DISK=public

# ---------- Shataj SMS Gateway (OTP) ----------
# log = OTP is written to storage/logs/laravel.log (for testing)
# shataj = send real SMS
SHATAJ_SMS_DRIVER=log
SHATAJ_SMS_URL=https://sms.shataj.com/api/v1/send
SHATAJ_SMS_METHOD=POST
SHATAJ_SMS_FORMAT=form
SHATAJ_SMS_API_KEY=
SHATAJ_SMS_SENDER_ID=
SHATAJ_SMS_AUTH_HEADER=
SHATAJ_SMS_PARAM_API_KEY=api_key
SHATAJ_SMS_PARAM_SENDER=senderid
SHATAJ_SMS_PARAM_TO=number
SHATAJ_SMS_PARAM_MESSAGE=message
SHATAJ_SMS_SUCCESS_KEY=
SHATAJ_SMS_SUCCESS_VALUES=success,ok,true,1,200,202

# ---------- ShatajPay Payment Gateway ----------
# fake = built-in test payment page, sandbox/live = real ShatajPay API
SHATAJPAY_MODE=fake
SHATAJPAY_BASE_URL=https://sandbox.shatajpay.com
SHATAJPAY_MERCHANT_ID=
SHATAJPAY_API_KEY=
SHATAJPAY_SECRET_KEY=
SHATAJPAY_CURRENCY=BDT
SHATAJPAY_INIT_ENDPOINT=/api/v1/payment/create
SHATAJPAY_VERIFY_ENDPOINT=/api/v1/payment/verify
SHATAJPAY_BEARER_AUTH=true
SHATAJPAY_SIGNATURE_HEADER=X-Signature
SHATAJPAY_PAYMENT_URL_KEY=data.payment_url
SHATAJPAY_CALLBACK_TXN_PARAM=transaction_id
SHATAJPAY_CALLBACK_REF_PARAM=invoice_id
SHATAJPAY_VERIFY_TXN_FIELD=transaction_id
SHATAJPAY_VERIFY_STATUS_KEY=data.status
SHATAJPAY_VERIFY_AMOUNT_KEY=data.amount
SHATAJPAY_VERIFY_REF_KEY=data.invoice_id
SHATAJPAY_SUCCESS_VALUES=success,completed,paid,valid
