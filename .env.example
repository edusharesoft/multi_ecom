APP_NAME="Chandrabindu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://multibranch.test
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multibranch_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log
BCRYPT_ROUNDS=12

# ---------- Shataj SMS Gateway (sms.shataj.com) ----------
# Admin panel → Payment & SMS Gateways overrides these values.
# log = SMS is written to storage/logs/laravel.log (testing), shataj = send real SMS
SHATAJ_SMS_DRIVER=log
SHATAJ_SMS_SERVER=https://sms.shataj.com
SHATAJ_SMS_API_KEY=
# 0 = primary device, 1 = device 1, 1|0 = device 1 SIM slot 1
SHATAJ_SMS_DEVICE=0
SHATAJ_SMS_COUNTRY_CODE=88

# ---------- ShatajPay Payment Gateway (pay.shataj.com) ----------
# Admin panel → Payment & SMS Gateways overrides these values.
# fake = built-in test payment page, sandbox / live = real ShatajPay API
SHATAJPAY_MODE=fake
SHATAJPAY_API_URL=https://pay.shataj.com
SHATAJPAY_USERNAME=
SHATAJPAY_PASSWORD=
SHATAJPAY_APP_KEY=
SHATAJPAY_APP_SECRET=
SHATAJPAY_GATEWAY_ID=
SHATAJPAY_CURRENCY=BDT
